{
  "info": {
    "name": "NEUST Activity 4.1 Laravel API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "GET Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "POST Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Sample Student\",\"email\":\"student@example.test\",\"password\":\"SecurePass123!\",\"password_confirmation\":\"SecurePass123!\"}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "POST Invalid User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"\",\"email\":\"not-an-email\"}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    }
  ]
}