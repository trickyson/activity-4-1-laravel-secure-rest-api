{
  "openapi": "3.0.3",
  "info": {
    "title": "NEUST Activity 4.1 — Secure Users REST API",
    "version": "1.0.0",
    "description": "Laravel 11 GET/POST user endpoints with validation and hashed passwords."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Users retrieved successfully"
          }
        }
      },
      "post": {
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Sample Student"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "sample@example.test"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "SecurePass123!"
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password",
                    "example": "SecurePass123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  }
}